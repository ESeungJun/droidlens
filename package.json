{
  "name": "droidlens",
  "private": true,
  "version": "0.1.0",
  "description": "Android 앱 분석·디버깅·시나리오 검증 툴 (adb 기반 + 선택형 SDK)",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "dev": "pnpm build && pnpm --filter @droidlens/desktop dev",
    "mcp": "node packages/mcp/dist/index.js",
    "typecheck": "pnpm -r run typecheck"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
