{
  "name": "@droidlens/core",
  "version": "0.15.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./graph-model": {
      "types": "./dist/graph-model.d.ts",
      "default": "./dist/graph-model.js"
    },
    "./scenario-view": {
      "types": "./dist/scenario-view.d.ts",
      "default": "./dist/scenario-view.js"
    },
    "./qa-note": {
      "types": "./dist/qa-note.d.ts",
      "default": "./dist/qa-note.js"
    },
    "./claude-auth": {
      "types": "./dist/claude-auth.d.ts",
      "default": "./dist/claude-auth.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test test/*.test.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.2",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "unpdf": "1.9.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "typescript": "~5.9.3"
  }
}
